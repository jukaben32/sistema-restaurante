<%
  // Menú superior. En computador: fila de íconos con tooltip. En teléfono: botón ☰ que abre una cuadrícula
  // con ícono + nombre (más fácil de tocar). Los accesos dependen del rol.
  // Relacionado con: middleware/auth.js (requireRole), app.js (rutaActual), public/css/movil.css, public/js/movil.js
  const u = (typeof user !== 'undefined' && user) ? user : null;
  const rol = u ? String(u.rol || '').toLowerCase() : '';
  const ruta = (typeof rutaActual !== 'undefined' && rutaActual) ? String(rutaActual) : '';

  const MENU = {
    administrador: [
      ['/dashboard', 'bi-speedometer2', 'Dashboard', 'Dashboard'],
      ['/', 'bi-house-fill', 'Venta rápida', 'Venta rápida'],
      ['/mesas', 'bi-grid', 'Mesas', 'Mesas'],
      ['/delivery', 'bi-bicycle', 'Delivery', 'Delivery'],
      ['/conversaciones', 'bi-chat-dots', 'Chats IA', 'Conversaciones (IA)'],
      ['/cocina', 'bi-egg-fried', 'Cocina', 'Cocina'],
      ['/ventas', 'bi-receipt', 'Ventas', 'Historial de ventas'],
      ['/reservas', 'bi-calendar-check', 'Reservas', 'Reservas'],
      ['/productos', 'bi-box', 'Productos', 'Gestionar productos'],
      ['/inventario', 'bi-box-seam', 'Inventario', 'Inventario'],
      ['/compras', 'bi-cart-check', 'Compras', 'Compras y gastos (606)'],
      ['/fiscal', 'bi-shield-check', 'Fiscal', 'Fiscal (DGII)'],
      ['/clientes', 'bi-people', 'Clientes', 'Gestionar clientes'],
      ['/usuarios', 'bi-person-gear', 'Usuarios', 'Usuarios'],
      ['/configuracion', 'bi-gear', 'Ajustes', 'Configuración'],
      ['/ayuda', 'bi-question-circle', 'Ayuda', 'Guía de uso']
    ],
    mesero: [
      ['/mesas', 'bi-grid', 'Mesas', 'Mesas'],
      ['/delivery', 'bi-bicycle', 'Delivery', 'Delivery'],
      ['/conversaciones', 'bi-chat-dots', 'Chats IA', 'Conversaciones (IA)'],
      ['/cocina', 'bi-egg-fried', 'Cocina', 'Cocina (listos)'],
      ['/reservas', 'bi-calendar-check', 'Reservas', 'Reservas'],
      ['/ayuda', 'bi-question-circle', 'Ayuda', 'Guía de uso']
    ],
    cocinero: [
      ['/cocina', 'bi-egg-fried', 'Cocina', 'Cocina'],
      ['/ayuda', 'bi-question-circle', 'Ayuda', 'Guía de uso']
    ]
  };
  const items = MENU[rol] || [];
  const activa = (href) => href === '/' ? (ruta === '/' || ruta === '') : (ruta === href || ruta.startsWith(href + '/'));
%>
<nav class="navbar navbar-expand-lg navbar-dark mb-4" style="background-color:#2c3e50;box-shadow:0 2px 4px rgba(0,0,0,.1);">
  <div class="container">
    <a class="navbar-brand fw-bold text-truncate m-0" href="/" style="color:#fff;font-size:1.2rem;max-width:calc(100vw - 110px);"><img src="/icons/icon.svg" alt="" width="26" height="26" class="me-2 align-text-bottom">Restaurant Martin</a>
    <% if (u && rol === 'administrador' && typeof fiscal !== 'undefined' && fiscal && fiscal.modo === 'no_fiscal') { %>
      <a href="/fiscal?tab=config" class="badge text-bg-warning text-decoration-none ms-2 d-none d-md-inline" title="Las ventas no llevan impuestos ni número fiscal. Toca para configurar.">Modo práctica · no fiscal</a>
    <% } else if (u && rol === 'administrador' && typeof fiscal !== 'undefined' && fiscal && fiscal.contingencia) { %>
      <a href="/fiscal?tab=config" class="badge text-bg-danger text-decoration-none ms-2 d-none d-md-inline">Contingencia (serie B)</a>
    <% } %>

    <% if (items.length || u) { %>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navPrincipal" aria-controls="navPrincipal" aria-expanded="false" aria-label="Abrir el menú">
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="navPrincipal">
        <div class="rm-nav-links">
          <% items.forEach(function (it) { %>
            <a href="<%= it[0] %>" class="btn btn-sm <%= activa(it[0]) ? 'btn-light' : 'btn-outline-light' %>" title="<%= it[3] %>" <%- activa(it[0]) ? 'aria-current="page"' : '' %>>
              <i class="bi <%= it[1] %>"></i><span class="rm-nav-txt"><%= it[2] %></span>
            </a>
          <% }); %>
        </div>

        <% if (u) { %>
          <div class="rm-nav-user">
            <span class="badge text-bg-light text-dark d-inline-flex align-items-center">
              <i class="bi bi-person-circle me-1"></i><%= u.usuario %> · <%= rol %>
            </span>
            <form method="POST" action="/logout" class="m-0">
              <button type="submit" class="btn btn-outline-light btn-sm" title="Cerrar sesión">
                <i class="bi bi-box-arrow-right"></i><span class="d-lg-none ms-2">Salir</span>
              </button>
            </form>
          </div>
        <% } %>
      </div>
    <% } %>
  </div>
</nav>
<% if (typeof alertasTiempo !== 'undefined' && alertasTiempo) { %><script>window.RM_ALERTAS = <%- JSON.stringify(alertasTiempo).replace(/</g, '\\u003c') %>;</script><% } %>
<script src="/js/pwa.js" defer></script>
<script src="/js/movil.js" defer></script>
<% if (u && rol === 'administrador') { %><script src="/js/demo-aviso.js" defer></script><% } %>
