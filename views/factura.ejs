<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= factura.ncf ? factura.ncf : 'Factura #' + factura.id %></title>
    <style>
        /* ====================================================
           REGLA @page — CRÍTICA para impresoras térmicas.
           Elimina encabezados/pies del navegador (URL, fecha,
           número de página) y fija el ancho del papel.
           Relacionado con: routes/facturas.js (GET /:id/imprimir)
           ==================================================== */
        @page {
            margin: 0mm 0mm 8mm 0mm;
            size: <%= config.ancho_papel %>mm auto;
        }

        @media print {
            html, body {
                width: <%= config.ancho_papel %>mm;
                max-width: <%= config.ancho_papel %>mm;
                margin: 0;
                padding: 3mm 3mm 8mm 3mm;
                font-size: <%= config.font_size === 2 ? '1.2em' : '1em' %>;
                background: #fff !important;
                color: #000 !important;
            }
            .no-print {
                display: none !important;
            }
            table {
                font-size: 0.9em;
            }
            .producto-item { page-break-inside: avoid; break-inside: avoid; }
        }

        body {
            font-family: Arial, sans-serif;
            max-width: <%= config.ancho_papel %>mm;
            margin: 0 auto;
            padding: 5px;
            font-size: <%= config.font_size === 2 ? '1.2em' : '1em' %>;
        }

        .text-center { text-align: center; }
        .text-right { text-align: right; }
        .mb-3 { margin-bottom: 15px; }
        .logo { max-width: 100px; margin: 0 auto; display: block; }
        .divider { border-top: 1px dashed #000; margin: 10px 0; }
        .small { font-size: 0.8em; }
        
        .producto-item {
            margin-bottom: 8px;
            padding-bottom: 4px;
            border-bottom: 1px dotted #ccc;
        }

        .producto-nombre {
            font-size: 0.85em;
            margin-bottom: 3px;
            word-break: break-word;
        }

        .producto-detalles {
            display: flex;
            justify-content: space-between;
            font-size: 0.85em;
            padding-left: 10px;
        }

        .producto-cantidad {
            flex: 1;
            text-align: left;
        }

        .producto-precio {
            flex: 1;
            text-align: center;
        }

        .producto-total {
            flex: 1;
            text-align: right;
        }

        .total-final {
            margin-top: 10px;
            text-align: right;
            font-weight: bold;
            font-size: 0.9em;
            border-top: 1px dashed #000;
            padding-top: 5px;
        }

        .totales { margin-top: 8px; font-size: 0.9em; }
        .totales .fila { display: flex; justify-content: space-between; padding: 1px 0; }
        .leyenda { margin-top: 8px; padding: 4px 6px; border: 1px solid #000; font-weight: bold; }
        .leyenda-mala { border-color: #b00020; color: #b00020; }
        .print-button {
            background: #007bff;
            color: white;
            border: none;
            padding: 10px 20px;
            border-radius: 5px;
            cursor: pointer;
            margin: 20px 0;
        }

        .print-button:hover {
            background: #0056b3;
        }

        @media screen {
            body {
                background: #f0f0f0;
                padding: 20px;
            }
            .factura {
                background: white;
                padding: 20px;
                box-shadow: 0 0 10px rgba(0,0,0,0.1);
                border-radius: 5px;
            }
        }
    </style>
</head>
<body>
    <div class="no-print" style="text-align: center; margin-bottom: 20px;">
        <button onclick="window.print()" class="print-button">Imprimir Factura</button>
        <%
            // Factura por WhatsApp (sin papel): abre wa.me con el resumen al teléfono del cliente
            // Relacionado con: routes/facturas.js (GET /:id/imprimir incluye c.telefono)
            let waTel = String(factura.telefono || '').replace(/[^\d]/g, '');
            const waCodigo = String((typeof codigoPaisWhatsapp !== 'undefined' && codigoPaisWhatsapp) || '').replace(/[^\d]/g, '');
            if (waTel.length === 10 && waCodigo && !waTel.startsWith(waCodigo)) waTel = waCodigo + waTel;
            const waLineas = (detalles || []).map(function (it) {
                return '• ' + Number(it.cantidad).toLocaleString('en-US', { maximumFractionDigits: 2 }) + ' ' + it.producto_nombre + ' — ' + fmt.rd(Math.abs(Number(it.subtotal)));
            });
            const waTexto = [
                '*' + (config.nombre_negocio || 'Restaurant Martin') + '*',
                (factura.ncf ? fmt.titulo(factura) + ' ' + factura.ncf : 'Factura #' + factura.id) + ' · ' + new Date(factura.fecha).toLocaleDateString('es-DO', { timeZone: 'America/Santo_Domingo' }),
                ''
            ].concat(waLineas)
             .concat(factura.fiscal_estado !== 'no_fiscal' ? ['', 'ITBIS: ' + fmt.rd(Math.abs(Number(factura.itbis_total))) + (Number(factura.propina) ? ' · Propina legal: ' + fmt.rd(Math.abs(Number(factura.propina))) : '')] : [])
             .concat(['', '*Total: ' + fmt.rd(factura.total) + '*'])
             .concat(factura.token_publico && typeof appUrl !== 'undefined' && appUrl ? ['', 'Tu comprobante: ' + appUrl + '/f/' + factura.token_publico] : [])
             .concat(['', config.pie_pagina || '¡Gracias por tu visita!']).join('\n');
            const waUrl = 'https://wa.me/' + (waTel.length >= 10 ? waTel : '') + '?text=' + encodeURIComponent(waTexto);
        %>
        <a href="<%= waUrl %>" target="_blank" rel="noopener" class="print-button" style="background:#25d366;text-decoration:none;display:inline-block;">
            WhatsApp<%= waTel.length >= 10 ? '' : ' (elegir contacto)' %>
        </a>
        <!-- Botón Volver: solo se muestra en pantalla completa (no en iframe/modal) -->
        <!-- Relacionado con: routes/facturas.js (embed=1 cuando se abre desde index/ventas) -->
        <% if (!(typeof embed !== 'undefined' && embed)) { %>
            <!-- Por defecto regresa al index, pero si viene desde Mesas se inyecta return_to='/mesas' -->
            <!-- Relacionado con: routes/facturas.js (GET /api/facturas/:id/imprimir -> return_to) -->
            <button onclick="window.location.href='<%= (typeof return_to !== "undefined" && return_to) ? return_to : "/" %>'" class="print-button" style="background: #6c757d;">Volver</button>
        <% } %>
        <% if (config && (config.impresora_facturas || config.factura_copias)) { %>
            <div style="margin-top:8px; color:#555; font-size:.9em;">
                Impresora sugerida: <strong><%= config.impresora_facturas || 'Predeterminada del sistema' %></strong>
                · Copias: <strong><%= Number(config.factura_copias || 1) %></strong>
            </div>
        <% } %>
    </div>

    <div class="factura">
        <%- include('partials/comprobante', { vence: typeof vence !== 'undefined' ? vence : null, qr: typeof qr !== 'undefined' ? qr : null }) %>
    </div>

    <% if (config && Number(config.factura_auto_print || 0) === 1) { %>
    <script>
        window.addEventListener('load', function () {
            try { window.print(); } catch (_) {}
        });
    </script>
    <% } %>
</body>
</html> 