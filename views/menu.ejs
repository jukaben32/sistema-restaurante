<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="theme-color" content="#1f2933">
    <title>Menú · <%= negocio.nombre_negocio || 'Restaurant Martin' %></title>
    <link href="/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/vendor/bootstrap-icons/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/martin.css">
    <style>
        body.menu { background: #faf8f5; color: var(--rm-ink); padding-bottom: 96px; }
        .m-hero { background: linear-gradient(160deg, #1f2933 0%, #2c3e50 100%); color: #fff; padding: 1.4rem 1rem 1.1rem; }
        .m-hero .logo { width: 52px; height: 52px; border-radius: 14px; object-fit: cover; background: #fff; }
        .m-hero h1 { font-size: 1.35rem; font-weight: 750; letter-spacing: -.01em; margin: 0; }
        .m-hero .mesa { background: rgba(255,255,255,.14); border-radius: 999px; padding: .2rem .7rem; font-size: .82rem; font-weight: 600; }
        .m-actions { display: grid; grid-template-columns: 1fr 1fr; gap: .5rem; margin-top: 1rem; }
        .m-actions .btn { border-radius: 12px; font-weight: 600; padding: .6rem .5rem; font-size: .9rem; }
        .m-tabs { position: sticky; top: 0; z-index: 20; background: #faf8f5; border-bottom: 1px solid var(--rm-line); }
        .m-tabs .scroller { display: flex; gap: .4rem; overflow-x: auto; padding: .6rem 1rem; scrollbar-width: none; }
        .m-tabs .scroller::-webkit-scrollbar { display: none; }
        .m-tab { flex: none; border: 1px solid var(--rm-line); background: #fff; color: var(--rm-ink); border-radius: 999px; padding: .35rem .85rem; font-size: .88rem; font-weight: 600; text-decoration: none; }
        .m-tab.active { background: var(--rm-ink); color: #fff; border-color: var(--rm-ink); }
        .m-sec { padding: 1rem 1rem .25rem; scroll-margin-top: 60px; }
        .m-sec h2 { font-size: 1.05rem; font-weight: 750; margin: 0 0 .6rem; }
        .m-item { display: flex; gap: .8rem; background: #fff; border: 1px solid var(--rm-line); border-radius: 16px; padding: .7rem; margin-bottom: .6rem; }
        .m-item .ph { width: 92px; height: 92px; border-radius: 12px; object-fit: cover; flex: none; background: #f1ede7; display: grid; place-items: center; color: #b8afa3; font-size: 1.6rem; }
        .m-item .info { flex: 1; min-width: 0; display: flex; flex-direction: column; }
        .m-item .nm { font-weight: 650; line-height: 1.25; }
        .m-item .ds { color: var(--rm-muted); font-size: .84rem; line-height: 1.3; margin-top: .15rem; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
        .m-item .ft { margin-top: auto; display: flex; align-items: center; justify-content: space-between; padding-top: .4rem; }
        .m-item .pr { font-weight: 700; font-variant-numeric: tabular-nums; }
        .m-item.agotado { opacity: .55; }
        .m-add { width: 36px; height: 36px; border-radius: 50%; border: 0; background: var(--rm-accent); color: #fff; display: grid; place-items: center; font-size: 1.1rem; }
        .m-qty { display: inline-flex; align-items: center; gap: .55rem; background: var(--rm-accent-soft); border-radius: 999px; padding: .15rem; }
        .m-qty button { width: 30px; height: 30px; border-radius: 50%; border: 0; background: #fff; color: var(--rm-accent); font-weight: 700; }
        .m-qty span { min-width: 1ch; font-weight: 700; color: var(--rm-accent); font-variant-numeric: tabular-nums; }
        .m-bar { position: fixed; left: 0; right: 0; bottom: 0; padding: .7rem 1rem calc(.7rem + env(safe-area-inset-bottom)); background: linear-gradient(to top, #faf8f5 70%, rgba(250,248,245,0)); z-index: 30; }
        .m-bar .btn { width: 100%; border-radius: 14px; padding: .85rem 1rem; font-weight: 700; display: flex; justify-content: space-between; align-items: center; box-shadow: 0 8px 24px rgba(194,65,12,.3); }
        .m-status li { display: flex; justify-content: space-between; gap: .5rem; padding: .45rem 0; border-bottom: 1px dashed var(--rm-line); font-size: .92rem; }
        .m-status li:last-child { border-bottom: 0; }
        .m-foot { text-align: center; color: var(--rm-muted); font-size: .82rem; padding: 1.5rem 1rem; }
        @media (min-width: 768px) { .m-wrap { max-width: 720px; margin: 0 auto; } }
    </style>
</head>
<body class="menu">
<% const fmtMoneda = String(negocio.moneda || 'usd').toUpperCase(); %>
<div class="m-wrap">
    <header class="m-hero">
        <div class="d-flex align-items-center gap-3">
            <% if (negocio.tiene_logo) { %><img class="logo" src="/menu/logo" alt=""><% } %>
            <div class="flex-grow-1 min-w-0">
                <h1><%= negocio.nombre_negocio || 'Restaurant Martin' %></h1>
                <% if (negocio.direccion) { %><div class="small opacity-75 text-truncate"><%= negocio.direccion %></div><% } %>
            </div>
            <span class="mesa"><i class="bi bi-geo-alt-fill me-1"></i>Mesa <%= mesa.numero %></span>
        </div>
        <div class="m-actions">
            <button class="btn btn-light" id="btnLlamar"><i class="bi bi-bell me-1"></i>Llamar mesero</button>
            <button class="btn btn-outline-light" id="btnCuenta"><i class="bi bi-receipt me-1"></i>Pedir la cuenta</button>
        </div>
    </header>

    <% if (categorias.length > 1) { %>
    <nav class="m-tabs" aria-label="Categorías">
        <div class="scroller">
            <% categorias.forEach(function (c, i) { %>
                <a class="m-tab <%= i === 0 ? 'active' : '' %>" href="#cat-<%= i %>"><%= c %></a>
            <% }); %>
        </div>
    </nav>
    <% } %>

    <section class="m-sec d-none" id="miPedido">
        <div class="rm-card p-3">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <h2 class="m-0"><i class="bi bi-clock-history me-1"></i>Tu mesa</h2>
                <strong id="miPedidoTotal" class="num"></strong>
            </div>
            <ul class="list-unstyled m-status mb-0" id="miPedidoLista"></ul>
        </div>
    </section>

    <main>
        <% if (categorias.length === 0) { %>
            <div class="rm-empty"><i class="bi bi-journal-x"></i>El menú aún no tiene productos publicados.</div>
        <% } %>
        <% categorias.forEach(function (c, i) { %>
            <section class="m-sec" id="cat-<%= i %>" data-cat-index="<%= i %>">
                <h2><%= c %></h2>
                <% porCategoria[c].forEach(function (p) { const agotado = Number(p.disponible) !== 1; %>
                    <article class="m-item <%= agotado ? 'agotado' : '' %>" data-id="<%= p.id %>" data-nombre="<%= p.nombre %>" data-precio="<%= Number(p.precio_unidad) %>">
                        <% if (p.tiene_imagen) { %>
                            <img class="ph" src="/menu/img/<%= p.id %>" alt="<%= p.nombre %>" loading="lazy">
                        <% } else { %>
                            <div class="ph" aria-hidden="true"><i class="bi bi-egg-fried"></i></div>
                        <% } %>
                        <div class="info">
                            <div class="nm"><%= p.nombre %></div>
                            <% if (p.descripcion) { %><div class="ds"><%= p.descripcion %></div><% } %>
                            <div class="ft">
                                <span class="pr" data-money="<%= Number(p.precio_unidad) %>"></span>
                                <% if (agotado) { %>
                                    <span class="rm-chip">Agotado</span>
                                <% } else { %>
                                    <div class="m-ctl"><button class="m-add" type="button" aria-label="Agregar <%= p.nombre %>"><i class="bi bi-plus-lg"></i></button></div>
                                <% } %>
                            </div>
                        </div>
                    </article>
                <% }); %>
            </section>
        <% }); %>
    </main>

    <footer class="m-foot">
        <a href="/reservar" class="link-secondary"><i class="bi bi-calendar-heart me-1"></i>Reserva tu próxima visita</a>
        <% if (negocio.telefono) { %><div class="mt-1"><i class="bi bi-telephone me-1"></i><%= negocio.telefono %></div><% } %>
    </footer>
</div>

<div class="m-bar d-none" id="barCarrito">
    <button class="btn btn-rm" type="button" data-bs-toggle="offcanvas" data-bs-target="#carrito">
        <span><i class="bi bi-bag me-2"></i>Ver pedido (<span id="barCant">0</span>)</span>
        <span id="barTotal" class="num"></span>
    </button>
</div>

<div class="offcanvas offcanvas-bottom" tabindex="-1" id="carrito" style="height: auto; max-height: 88vh; border-radius: 18px 18px 0 0;">
    <div class="offcanvas-header pb-2">
        <h5 class="offcanvas-title fw-bold">Tu pedido · Mesa <%= mesa.numero %></h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Cerrar"></button>
    </div>
    <div class="offcanvas-body pt-0">
        <div id="carritoLista" class="vstack gap-2"></div>
        <div class="mt-3">
            <label class="form-label small fw-semibold" for="nombreCliente">Tu nombre (opcional)</label>
            <input id="nombreCliente" class="form-control" maxlength="60" placeholder="Para saber a quién servir">
        </div>
        <div class="d-flex justify-content-between align-items-center mt-3">
            <span class="text-muted">Total</span>
            <strong class="fs-5 num" id="carritoTotal"></strong>
        </div>
        <button class="btn btn-rm w-100 mt-3 py-3 fw-bold" id="btnEnviar"><i class="bi bi-send me-1"></i>Enviar pedido</button>
        <p class="small text-muted text-center mt-2 mb-0">Un mesero confirmará tu pedido antes de pasarlo a cocina.</p>
    </div>
</div>

<script>window.MENU = { token: <%- JSON.stringify(token) %>, moneda: <%- JSON.stringify(fmtMoneda) %> };</script>
<script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
<script src="/vendor/sweetalert2/sweetalert2.all.min.js"></script>
<script src="/js/menu.js"></script>
</body>
</html>
