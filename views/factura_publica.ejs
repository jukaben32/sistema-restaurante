<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex, nofollow">
    <title><%= factura.ncf ? factura.ncf : 'Comprobante' %> · <%= config.nombre_negocio || 'Restaurant Martin' %></title>
    <style>
        body { font-family: Arial, sans-serif; background: #f0f0f0; margin: 0; padding: 16px; font-size: 15px; color: #111; }
        .factura { background: #fff; max-width: 420px; margin: 0 auto; padding: 20px; box-shadow: 0 0 10px rgba(0,0,0,.1); border-radius: 6px; }
        .text-center { text-align: center; } .small { font-size: .82em; } .mb-3 { margin-bottom: 14px; } .mt-2 { margin-top: 8px; } .mt-3 { margin-top: 14px; }
        .logo { max-width: 100px; margin: 0 auto; display: block; }
        .divider { border-top: 1px dashed #000; margin: 10px 0; }
        .producto-item { margin-bottom: 8px; padding-bottom: 4px; border-bottom: 1px dotted #ccc; }
        .producto-nombre { font-size: .9em; margin-bottom: 3px; word-break: break-word; }
        .producto-detalles { display: flex; justify-content: space-between; font-size: .85em; padding-left: 10px; }
        .producto-detalles > div { flex: 1; } .producto-precio { text-align: center; } .producto-total { text-align: right; }
        .totales { margin-top: 8px; font-size: .9em; }
        .totales .fila { display: flex; justify-content: space-between; padding: 1px 0; }
        .total-final { margin-top: 8px; text-align: right; font-weight: bold; border-top: 1px dashed #000; padding-top: 5px; }
        .leyenda { margin-top: 8px; padding: 4px 6px; border: 1px solid #000; font-weight: bold; }
        .leyenda-mala { border-color: #b00020; color: #b00020; }
        .acciones { text-align: center; margin: 14px 0 0; }
        .acciones button { background: #007bff; color: #fff; border: 0; padding: 10px 20px; border-radius: 5px; cursor: pointer; font-size: 1em; }
        @media print { body { background: #fff; padding: 0; } .factura { box-shadow: none; } .acciones { display: none; } }
    </style>
</head>
<body>
    <div class="factura">
        <%- include('partials/comprobante', { vence: null, qr: qr, cliente: cliente }) %>
    </div>
    <div class="acciones"><button onclick="window.print()">Imprimir o guardar en PDF</button></div>
</body>
</html>
