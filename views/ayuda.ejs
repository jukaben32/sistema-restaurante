<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('partials/head') %>
    <title>Guía de uso · Restaurant Martin</title>
    <style>
        .guia-layout { display: grid; grid-template-columns: 280px minmax(0, 1fr); gap: 1.25rem; align-items: start; }
        @media (max-width: 991.98px) { .guia-layout { grid-template-columns: 1fr; } }
        .toc { position: sticky; top: 12px; max-height: calc(100vh - 24px); overflow: auto; padding: .9rem; }
        @media (max-width: 991.98px) { .toc { position: static; max-height: none; } }
        .toc a { display: block; padding: .3rem .4rem; border-radius: 8px; color: var(--rm-ink); text-decoration: none; font-size: .92rem; line-height: 1.25; }
        .toc a:hover { background: #eef1f5; }
        .toc a.sec { font-weight: 650; margin-top: .35rem; }
        .toc a.sub { padding-left: 1.2rem; color: var(--rm-muted); font-size: .84rem; }
        .guia-seccion { margin-bottom: 1rem; scroll-margin-top: 12px; }
        .guia-seccion > summary { list-style: none; cursor: pointer; padding: 1rem 1.1rem; display: flex; align-items: center; gap: .6rem; font-weight: 700; font-size: 1.15rem; }
        .guia-seccion > summary::-webkit-details-marker { display: none; }
        .guia-seccion > summary::after { content: '\F282'; font-family: 'bootstrap-icons'; margin-left: auto; transition: transform .2s; color: var(--rm-muted); }
        .guia-seccion[open] > summary::after { transform: rotate(180deg); }
        .guia-cuerpo { padding: 0 1.1rem 1.1rem; }
        .guia h3 { font-size: 1.1rem; font-weight: 700; margin: 1.6rem 0 .6rem; padding-top: .4rem; border-top: 1px solid var(--rm-line); scroll-margin-top: 12px; }
        .guia h3:first-child { border-top: 0; margin-top: .5rem; }
        .guia p, .guia li { line-height: 1.6; }
        .guia ol, .guia ul { padding-left: 1.4rem; }
        .guia li { margin: .25rem 0; }
        .guia-nota { background: var(--rm-accent-soft); border-left: 4px solid var(--rm-accent); border-radius: 8px; padding: .65rem .9rem; margin: .9rem 0; }
        .guia-nota p { margin: 0; }
        .guia table { font-size: .92rem; }
        .guia table th { background: #f1f3f6; white-space: nowrap; }
        .guia code { background: #eef1f5; border-radius: 5px; padding: .05rem .35rem; font-size: .88em; color: #7c2d12; }
        .guia hr { display: none; }
        .rol-chip { font-size: .72rem; }
        .sin-resultados { display: none; }
        mark.guia-resalte { background: #fde68a; padding: 0 .1em; border-radius: 3px; }
        @media print {
            nav, footer, .no-print, .toc { display: none !important; }
            body.rm { background: #fff; }
            .guia-layout { display: block; }
            .guia-seccion { break-inside: auto; box-shadow: none; border: 0; }
            .guia-seccion > summary::after { display: none; }
            .guia h3 { break-after: avoid; }
            .guia table { break-inside: avoid; }
        }
    </style>
</head>
<body class="rm">
    <%- include('partials/navbar') %>
    <%
        const visibles = guia.secciones.filter(function (s) { return verTodo || aplica(s); });
        const etiquetaRol = { administrador: 'administrador', mesero: 'mesero', cocinero: 'cocinero' }[rol] || 'usuario';
    %>
    <main class="rm-page container pb-5">
        <div class="d-flex align-items-start justify-content-between flex-wrap gap-2 mb-3 no-print">
            <div>
                <h1 class="rm-title h3"><i class="bi bi-life-preserver me-2" style="color:var(--rm-accent)"></i><%= guia.titulo %></h1>
                <p class="rm-sub">
                    <% if (verTodo) { %>Estás viendo <b>toda la guía</b>.<% } else { %>Estás viendo lo que corresponde a tu rol: <b><%= etiquetaRol %></b>.<% } %>
                </p>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <% if (verTodo) { %>
                    <a class="btn btn-outline-secondary btn-sm" href="/ayuda"><i class="bi bi-person-check"></i> Solo mi rol</a>
                <% } else { %>
                    <a class="btn btn-outline-secondary btn-sm" href="/ayuda?todo=1"><i class="bi bi-journal-text"></i> Ver toda la guía</a>
                <% } %>
                <button class="btn btn-outline-secondary btn-sm" onclick="window.print()"><i class="bi bi-printer"></i> Imprimir</button>
                <a class="btn btn-outline-secondary btn-sm" href="/ayuda/guia.md" download><i class="bi bi-download"></i> Descargar</a>
            </div>
        </div>

        <div class="rm-card mb-3 p-3 no-print">
            <label for="buscar" class="form-label small fw-semibold mb-1"><i class="bi bi-search me-1"></i>Buscar en la guía</label>
            <div class="input-group">
                <input id="buscar" type="search" class="form-control" placeholder="Escribe una palabra, por ejemplo: factura, reserva, contraseña…" autocomplete="off">
                <button class="btn btn-outline-secondary" type="button" id="limpiar" aria-label="Borrar búsqueda"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="small text-muted mt-1" id="estadoBusqueda" aria-live="polite"></div>
        </div>

        <div class="guia-layout">
            <aside class="rm-card toc no-print" aria-label="Contenido de la guía">
                <div class="fw-bold mb-1"><i class="bi bi-list-ul me-1"></i>Contenido</div>
                <% visibles.forEach(function (s) { %>
                    <a class="sec" href="#<%= s.id %>" data-abrir="<%= s.id %>"><%= s.titulo %></a>
                    <% s.subsecciones.forEach(function (t) { %><a class="sub" href="#<%= t.id %>" data-abrir="<%= s.id %>"><%= t.titulo.replace(/\*\*/g, '') %></a><% }); %>
                <% }); %>
            </aside>

            <div class="guia" id="guia">
                <div class="rm-card p-3 mb-3 guia-cuerpo" style="padding-bottom:1rem"><%- guia.introHtml %></div>

                <% visibles.forEach(function (s, i) { %>
                    <details class="rm-card guia-seccion" id="<%= s.id %>" data-seccion <%= (i < 2 || (rol && s.titulo.toUpperCase().indexOf(rol.toUpperCase()) !== -1)) ? 'open' : '' %>>
                        <summary>
                            <span><%= s.titulo %></span>
                            <% if (s.roles.length) { %>
                                <% s.roles.forEach(function (r) { %><span class="rm-chip rol-chip <%= r === rol ? 'ok' : '' %> no-print"><%= r %></span><% }); %>
                            <% } %>
                        </summary>
                        <div class="guia-cuerpo"><%- s.html %></div>
                    </details>
                <% }); %>

                <div class="rm-card rm-empty sin-resultados" id="sinResultados"><i class="bi bi-search"></i>No encontré nada con esa palabra. Prueba con otra.</div>
            </div>
        </div>
    </main>
    <%- include('partials/footer') %>
    <script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script>
    (function () {
        var norm = function (s) { return String(s || '').normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase(); };
        var secciones = [].slice.call(document.querySelectorAll('[data-seccion]'));
        var textos = secciones.map(function (s) { return norm(s.textContent); });
        var input = document.getElementById('buscar');
        var estado = document.getElementById('estadoBusqueda');
        var vacio = document.getElementById('sinResultados');
        var original = secciones.map(function (s) { return s.open; });

        function quitarMarcas() {
            [].slice.call(document.querySelectorAll('mark.guia-resalte')).forEach(function (m) {
                var p = m.parentNode; p.replaceChild(document.createTextNode(m.textContent), m); p.normalize();
            });
        }
        function resaltar(raiz, q) {
            var w = document.createTreeWalker(raiz, NodeFilter.SHOW_TEXT, null);
            var nodos = [], n;
            while ((n = w.nextNode())) { if (n.parentNode.nodeName !== 'SCRIPT' && norm(n.nodeValue).indexOf(q) !== -1) nodos.push(n); }
            nodos.slice(0, 60).forEach(function (nodo) {
                var t = nodo.nodeValue, nt = norm(t), i = nt.indexOf(q);
                if (i < 0 || nt.length !== t.length) return; // si la normalización cambia el largo, no se resalta
                var m = document.createElement('mark'); m.className = 'guia-resalte'; m.textContent = t.substr(i, q.length);
                var despues = nodo.splitText(i); despues.nodeValue = despues.nodeValue.substr(q.length);
                nodo.parentNode.insertBefore(m, despues);
            });
        }
        function buscar() {
            var q = norm(input.value).trim();
            quitarMarcas();
            if (q.length < 2) {
                secciones.forEach(function (s, i) { s.style.display = ''; s.open = original[i]; });
                vacio.style.display = 'none'; estado.textContent = '';
                return;
            }
            var hallados = 0;
            secciones.forEach(function (s, i) {
                var ok = textos[i].indexOf(q) !== -1;
                s.style.display = ok ? '' : 'none';
                if (ok) { hallados++; s.open = true; resaltar(s, q); }
            });
            vacio.style.display = hallados ? 'none' : 'block';
            estado.textContent = hallados ? ('Se encontró en ' + hallados + ' sección(es).') : '';
        }
        var t = null;
        input.addEventListener('input', function () { clearTimeout(t); t = setTimeout(buscar, 200); });
        document.getElementById('limpiar').addEventListener('click', function () { input.value = ''; buscar(); input.focus(); });

        // Al tocar un título del contenido, se abre su sección
        document.querySelectorAll('[data-abrir]').forEach(function (a) {
            a.addEventListener('click', function () { var s = document.getElementById(a.getAttribute('data-abrir')); if (s) s.open = true; });
        });
        // Si entras con #ancla (por ejemplo desde otro enlace), abre esa sección
        if (location.hash) {
            var el = document.getElementById(decodeURIComponent(location.hash.slice(1)));
            var det = el && el.closest ? el.closest('details') : null;
            if (det) { det.open = true; setTimeout(function () { el.scrollIntoView(); }, 50); }
        }
        // Al imprimir se abren todas las secciones
        window.addEventListener('beforeprint', function () { secciones.forEach(function (s) { s.open = true; }); });
    })();
    </script>
</body>
</html>
