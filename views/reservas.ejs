<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('partials/head') %>
    <title>Reservas · Restaurant Martin</title>
    <style>
        .dias { display: flex; gap: .4rem; overflow-x: auto; padding-bottom: .25rem; scrollbar-width: thin; }
        .dia { flex: none; width: 64px; border: 1px solid var(--rm-line); background: #fff; border-radius: 12px; padding: .4rem .2rem; text-align: center; cursor: pointer; }
        .dia .d { font-size: .7rem; text-transform: uppercase; color: var(--rm-muted); font-weight: 600; }
        .dia .n { font-size: 1.15rem; font-weight: 700; line-height: 1.1; }
        .dia .c { font-size: .7rem; color: var(--rm-accent); font-weight: 700; min-height: 1em; }
        .dia.active { background: var(--rm-ink); border-color: var(--rm-ink); color: #fff; }
        .dia.active .d, .dia.active .c { color: #fff; opacity: .85; }
        .res { display: flex; gap: .9rem; align-items: flex-start; padding: .9rem 1.1rem; border-bottom: 1px solid var(--rm-line); }
        .res:last-child { border-bottom: 0; }
        .res .hora { font-size: 1.2rem; font-weight: 750; font-variant-numeric: tabular-nums; width: 64px; flex: none; }
        .res .acc { display: flex; flex-wrap: wrap; gap: .3rem; margin-top: .45rem; }
    </style>
</head>
<body class="rm">
    <%- include('partials/navbar') %>
    <main class="rm-page container pb-5">
        <div class="d-flex align-items-start justify-content-between flex-wrap gap-2 mb-3">
            <div>
                <h1 class="rm-title h3"><i class="bi bi-calendar-check me-2" style="color:var(--rm-accent)"></i>Reservas</h1>
                <p class="rm-sub">Agenda del día, reservas recibidas desde la web y asignación de mesas.</p>
            </div>
            <div class="d-flex gap-2">
                <a class="btn btn-outline-secondary" href="/reservar" target="_blank" rel="noopener"><i class="bi bi-link-45deg"></i> Formulario público</a>
                <button class="btn btn-rm" id="btnNueva"><i class="bi bi-plus-lg"></i> Nueva reserva</button>
            </div>
        </div>

        <div class="rm-card mb-3">
            <div class="rm-card-b">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <input type="date" id="fecha" class="form-control form-control-sm" style="max-width: 170px;">
                    <button class="btn btn-sm btn-outline-secondary" id="hoy">Hoy</button>
                    <span class="ms-auto small text-muted" id="resumenDia"></span>
                </div>
                <div class="dias" id="dias"></div>
            </div>
        </div>

        <div class="rm-card">
            <div id="lista"><div class="rm-empty"><span class="rm-pulse"></span>Cargando…</div></div>
        </div>
    </main>

    <!-- Modal crear/editar -->
    <div class="modal fade" id="modalReserva" tabindex="-1">
        <div class="modal-dialog">
            <form class="modal-content" id="formReserva">
                <div class="modal-header">
                    <h5 class="modal-title" id="tituloModal">Nueva reserva</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="rId">
                    <div class="row g-2">
                        <div class="col-12"><label class="form-label small" for="rNombre">Nombre</label><input id="rNombre" class="form-control" required maxlength="100"></div>
                        <div class="col-6"><label class="form-label small" for="rTelefono">Teléfono</label><input id="rTelefono" class="form-control" maxlength="30" inputmode="tel"></div>
                        <div class="col-6"><label class="form-label small" for="rEmail">Correo</label><input id="rEmail" type="email" class="form-control" maxlength="120"></div>
                        <div class="col-7"><label class="form-label small" for="rFechaHora">Fecha y hora</label><input id="rFechaHora" type="datetime-local" class="form-control" required></div>
                        <div class="col-5"><label class="form-label small" for="rPersonas">Personas</label><input id="rPersonas" type="number" min="1" max="50" value="2" class="form-control" required></div>
                        <div class="col-12">
                            <label class="form-label small" for="rMesa">Mesa (opcional)</label>
                            <select id="rMesa" class="form-select">
                                <option value="">Sin asignar</option>
                                <% mesas.forEach(function (m) { %><option value="<%= m.id %>">Mesa <%= m.numero %></option><% }); %>
                            </select>
                        </div>
                        <div class="col-12"><label class="form-label small" for="rNotas">Notas</label><textarea id="rNotas" class="form-control" rows="2" maxlength="500" placeholder="Cumpleaños, silla para bebé, alergias…"></textarea></div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-rm">Guardar</button>
                </div>
            </form>
        </div>
    </div>

    <%- include('partials/footer') %>
    <script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="/vendor/sweetalert2/sweetalert2.all.min.js"></script>
    <script src="/js/reservas.js"></script>
</body>
</html>
