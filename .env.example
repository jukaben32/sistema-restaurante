# Supabase -> Connect -> Session pooler (funciona con IPv4)
DATABASE_URL=postgresql://postgres.TU_REF:TU_PASSWORD@aws-0-TU_REGION.pooler.supabase.com:5432/postgres
DB_TIMEZONE=America/Santo_Domingo
PORT=3000
# Cadena aleatoria larga (ej.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=
# Llave para cifrar secretos guardados en la BD (llaves de Stripe). No la cambies después de configurar Stripe.
APP_ENCRYPTION_KEY=
# Opcional: llaves de Stripe por variables de entorno (si no se configuran desde la app)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Código de país para enviar facturas por WhatsApp (ej.: 1 República Dominicana, 57 Colombia)
WHATSAPP_CODIGO_PAIS=1
